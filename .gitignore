# Original packages and publisher assets are never committed.
*.apk
*.xapk
*.apks
*.aab
*.obb
*.bundle
*.unity3d

# Runtime state, rollback payloads, and captures.
install-state/
previous-apks/
captures/
private/
secrets/
*.log
*.partial
*.tmp

# Python / test caches.
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# IDE / OS.
.vscode/
.idea/
.DS_Store
Thumbs.db
